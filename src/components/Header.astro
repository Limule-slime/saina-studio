---
import Brand from './Brand.astro';
import MobileMenu from './MobileMenu.tsx';
import { nav } from '../data/site';

interface Props {
	current?: string;
}
const { current } = Astro.props;
---

<header class="site-header">
	<div class="bar glass">
		<a class="home" href="/" aria-label="Saina Studio, accueil"><Brand /></a>
		<nav class="links" aria-label="Principale">
			<ul>
				{
					nav.map((item) => (
						<li>
							<a href={item.href} aria-current={current === item.label ? 'page' : undefined}>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
		<div class="actions">
			<a class="btn btn--light cta" href="/kits/saina-blocks/#tarifs">Télécharger</a>
			<MobileMenu client:media="(max-width: 59.99rem)" items={[...nav]} />
		</div>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		padding: 1.25rem var(--sn-space-gutter) 0;
	}

	.bar {
		display: flex;
		align-items: center;
		gap: 2rem;
		max-width: var(--sn-width-content);
		margin-inline: auto;
		padding: 0.5rem 0.5rem 0.5rem 1.5rem;
		border-radius: var(--sn-radius-pill);
		background: rgb(11 13 12 / 0.55);
	}

	.home {
		text-decoration: none;
	}

	.links {
		flex: 1;
	}

	.links ul {
		display: flex;
		justify-content: center;
		gap: 1.75rem;
		padding: 0;
		list-style: none;
	}

	.links a {
		font-size: var(--sn-text-sm);
		color: var(--sn-color-text-muted);
		text-decoration: none;
		transition: color var(--sn-duration-fast) ease;
	}

	.links a:hover,
	.links a[aria-current='page'] {
		color: var(--sn-color-text-primary);
	}

	.actions {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-left: auto;
	}

	@media (max-width: 59.99rem) {
		.links,
		.cta {
			display: none;
		}

		.bar {
			padding-left: 1.125rem;
		}
	}
</style>
