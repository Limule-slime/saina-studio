---
import Brand from './Brand.astro';
import { site } from '../data/site';

const columns = [
	{
		title: 'Produits',
		links: [
			{ label: 'Saina Blocks', href: '/kits/saina-blocks/' },
			{ label: 'Prochains kits', href: '/#catalogue' },
		],
	},
	{
		title: 'Ressources',
		links: [
			{ label: 'Accessibilité', href: site.accessibilityStatement },
			{ label: 'Tarifs', href: '/kits/saina-blocks/#tarifs' },
		],
	},
	{
		title: 'Contact',
		links: [
			{ label: 'Écrire au support', href: `mailto:${site.email}` },
			{ label: 'LinkedIn', href: site.linkedin },
			{ label: 'WordPress.org', href: site.wordpressProfile },
		],
	},
];
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="wrap">
		<div class="top">
			<div class="about">
				<Brand size="lg" />
				<p class="muted">
					Kits WordPress et Figma accessibles. Conçus et développés par {site.author}, à Antananarivo.
				</p>
			</div>
			{
				columns.map((col) => (
					<nav aria-label={col.title}>
						<p class="label">{col.title}</p>
						<ul>
							{col.links.map((link) => (
								<li>
									<a href={link.href}>{link.label}</a>
								</li>
							))}
						</ul>
					</nav>
				))
			}
		</div>
		<div class="bottom label">
			<p>© {year} Saina Studio</p>
			<p><a href="/mentions-legales/">Mentions légales</a></p>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: var(--sn-space-section);
		border-top: 1px solid var(--sn-color-border-default);
		padding-block: 3rem 2.5rem;
	}

	.top {
		display: grid;
		gap: 2.5rem;
	}

	@media (min-width: 48rem) {
		.top {
			grid-template-columns: 1fr repeat(3, auto);
			gap: 4rem;
		}
	}

	.about p {
		max-width: 21rem;
		margin-top: 0.75rem;
		font-size: var(--sn-text-sm);
	}

	ul {
		display: grid;
		gap: 0.6rem;
		margin-top: 0.9rem;
		padding: 0;
		list-style: none;
	}

	a {
		font-size: var(--sn-text-sm);
		text-decoration: none;
	}

	a:hover {
		text-decoration: underline;
		text-underline-offset: 0.3em;
	}

	.bottom {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 2rem;
		margin-top: 3.5rem;
		text-transform: none;
		letter-spacing: 0.02em;
	}
</style>
